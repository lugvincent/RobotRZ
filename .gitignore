# =============================================================================
# NOM        : .gitignore
# CHEMIN     : racine du depot lugvincent/RobotRZ
# OBJECTIF   : exclure du suivi Git les artefacts de compilation, les fichiers
#              de configuration generes, les identifiants, et les dossiers
#              locaux du PC qui cohabitent avec le depot sans en faire partie.
# PRECAUTION : ce depot est PUBLIC. Tout fichier non exclu ici part en ligne
#              au premier `git add .`. Verifier avant d'elargir une exclusion.
# VERSION    : 2.0 - 18/10/2026 - doublons supprimes, exclusion de
#              RobotRZ-horsIO ajoutee (contenait Id-code-clef.txt expose)
# =============================================================================

# --- Compilation et outillage ------------------------------------------------
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
pyrightconfig.json

# --- Journaux ----------------------------------------------------------------
logs/
termux/logs/

# --- Configuration generee a l'execution (produite par check_config.sh) ------
termux/config/*_runtime.json
termux/config/global.json
termux/config/global.json.tmp
termux/config/appli_config.json
termux/config/sensors/cam_config.json
termux/config/sensors/mic_config.json
termux/config/sensors/stt_config.json
termux/config/sensors/voice_config.json
termux/liste_git_avant.txt

# --- Identifiants : jamais versionnes ----------------------------------------
termux/config/keys.json
.env

# --- PocketSphinx : abandonne, modeles volumineux ----------------------------
termux/scripts/sensors/stt/lib_pocketsphinx/
termux/scripts/sensors/stt/lib_pocketsphinx/model-fr/
termux/scripts/sensors/stt/lib_pocketsphinx/fr.dict
termux/scripts/sensors/stt/lib_pocketsphinx/lexique_referent.dict

# --- Restes de travail -------------------------------------------------------
termux/scripts/core/rz_state-manager.sh.save
termux/scripts/core/rz_state-manager.sh.save.1
termux/scripts/sensors/stt/__pycache__/
termux/scripts/sensors/stt/old_rz_autovoice_bridge.sh
termux/scripts/sensors/stt/rz_stt_debug.py
tasker/tasks/old*.tsk.xml
tasker/profiles/old*.prf.xml

# --- Dossiers locaux du PC, voisins du depot mais hors depot -----------------
#
# RobotRZ-horsIO : systeme documentaire personnel de Vincent, range sous
#   FUTUR-DOC de A a I, avec AA-RZ-Vactuel-Doc pour le courant et CODE pour
#   les copies de travail. 928 fichiers, 131 Mo, surtout des documents
#   bureautiques et des PDF : cela n'a pas sa place dans un depot de code.
#   Surtout, il contient Id-code-clef.txt. Le depot etant public, un
#   `git add .` lance depuis Documents\ProjetRZ aurait publie ce fichier.
#   Verifie le 18/10/2026 : jamais commite a ce jour, le risque etait devant.
#   Pour versionner un document de ce dossier, le COPIER deliberement dans
#   docs/dev_RZ_HTML/ — ne jamais lever cette exclusion.
RobotRZ-horsIO/
#
# InstallationServeur : notes d'installation locales (2 fichiers, juin 2025)
InstallationServeur/

# --- Filet de securite sur les noms de fichiers ------------------------------
# Volontairement etroit : un motif large (par exemple *cle*) exclurait en
# silence des fichiers legitimes comme declencheurs.txt, ce qui est pire que
# le probleme qu'il resout. On ne couvre que des noms sans ambiguite.
*clef*
Id-code-*
*secret*
*password*
